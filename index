.bg-standby { background-color: #000; border: 1px solid #38383a; }
.bg-control { background-color: #8e8e93; }
.bg-notifications { background-color: #ff453a; }
.bg-sound { background-color: #ff2d55; }
.bg-focus { background-color: #5856d6; }
.bg-screentime { background-color: #5856d6; }
</style>
</head>
