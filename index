<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
<title>설정</title>
<meta name="apple-mobile-web-app-title" content="설정"/>
<meta name="apple-mobile-web-app-capable" content="yes"/>
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
<meta name="theme-color" content="#000000"/>
<style>
:root {
  --bg-color: #000000;
  --card-bg: #1c1c1e;
  --card-active: #2c2c2e;
  --text-color: #ffffff;
  --text-muted: #8e8e93;
  --separator: #38383a;
  --blue: #0a84ff;
  --green: #30d158;
  --red: #ff453a;
  --orange: #ff9f0a;
  --yellow: #ffd60a;
  --safe-top: env(safe-area-inset-top, 47px);
  --safe-bottom: env(safe-area-inset-bottom, 34px);
}

* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
html, body {
  margin: 0; padding: 0;
  width: 100%; height: 100%;
  background-color: var(--bg-color);
  color: var(--text-color);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "Helvetica Neue", Arial, sans-serif;
  user-select: none;
  -webkit-user-select: none;
  overflow-x: hidden;
}

/* Status Bar Mockup */
.status-bar {
  position: fixed; top: 0; left: 0; right: 0;
  height: var(--safe-top);
  display: flex; justify-content: space-between; align-items: flex-end;
  padding: 0 24px 10px;
  z-index: 100;
  font-weight: 600; font-size: 15px;
  background: rgba(0,0,0,0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}
.status-bar .time { font-size: 15px; font-weight: 600; }
.status-bar .icons { display: flex; gap: 6px; align-items: center; font-size: 12px; }
.status-bar .battery-icon {
  width: 25px; height: 12px; border: 1px solid #fff; border-radius: 4px; padding: 1px; position: relative;
}
.status-bar .battery-icon::after {
  content:''; position: absolute; right: -3.5px; top: 3px; width: 2px; height: 4px; background: #fff; border-radius: 0 1px 1px 0;
}
.status-bar .battery-level { width: 46%; height: 100%; background: #fff; border-radius: 2px; }

/* Screen Management */
.screen {
  position: absolute; top: 0; left: 0; width: 100%; min-height: 100vh;
  padding-top: calc(var(--safe-top) + 12px);
  padding-bottom: calc(var(--safe-bottom) + 20px);
  display: none;
  background: var(--bg-color);
  animation: slideIn 0.25s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
}
.screen.active { display: block; }
.screen.back-anim { animation: slideOut 0.25s cubic-bezier(0.2, 0.8, 0.2, 1) forwards; }

@keyframes slideIn {
  from { transform: translateX(100%); opacity: 0.9; }
  to { transform: translateX(0); opacity: 1; }
}
@keyframes slideOut {
  from { transform: translateX(0); }
  to { transform: translateX(100%); }
}

/* Header UI */
.nav-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 4px 16px 12px;
  position: sticky; top: var(--safe-top);
  background: rgba(0,0,0,0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  z-index: 90;
}
.nav-back {
  display: flex; align-items: center; color: var(--blue); font-size: 17px; cursor: pointer; border: none; background: none; padding: 0;
}
.nav-back svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; margin-right: 4px; }
.nav-title { font-size: 17px; font-weight: 600; flex: 1; text-align: center; }
.nav-action { font-size: 17px; color: var(--blue); cursor: pointer; border: none; background: none; }

.large-title {
  font-size: 34px; font-weight: 700; padding: 10px 16px 15px; letter-spacing: -0.5px;
}

/* Card / Group Section */
.group {
  margin: 0 16px 20px;
  background-color: var(--card-bg);
  border-radius: 12px;
  overflow: hidden;
}
.group-title {
  font-size: 13px; color: var(--text-muted); text-transform: uppercase; margin: 0 32px 6px; padding-top: 10px;
}
.group-footer {
  font-size: 13px; color: var(--text-muted); margin: 6px 32px 16px; line-height: 1.4;
}

/* List Row Item */
.row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 11px 16px; min-height: 48px;
  position: relative; cursor: pointer;
}
.row:active { background-color: var(--card-active); }
.row:not(:last-child)::after {
  content: ''; position: absolute; left: 56px; right: 0; bottom: 0; height: 0.5px; background-color: var(--separator);
}
.row.no-icon:not(:last-child)::after { left: 16px; }

.row-left { display: flex; align-items: center; gap: 12px; flex: 1; min-width: 0; }
.row-icon {
  width: 30px; height: 30px; border-radius: 7px;
  display: flex; align-items: center; justify-content: center;
  color: #fff; flex-shrink: 0; font-size: 16px;
}
.row-icon svg { width: 18px; height: 18px; fill: currentColor; }

.row-text { display: flex; flex-direction: column; flex: 1; min-width: 0; }
.row-title { font-size: 17px; font-weight: 400; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.row-sub { font-size: 12px; color: var(--text-muted); margin-top: 2px; }

.row-right { display: flex; align-items: center; gap: 8px; color: var(--text-muted); font-size: 17px; }
.badge {
  background-color: var(--red); color: #fff; font-size: 13px; font-weight: 600;
  width: 20px; height: 20px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
.chevron { width: 8px; height: 13px; fill: none; stroke: #545458; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

/* Switch Toggle */
.switch {
  position: relative; width: 51px; height: 31px;
  background-color: #39393d; border-radius: 16px;
  transition: background-color 0.25s; cursor: pointer;
}
.switch::after {
  content: ''; position: absolute; top: 2px; left: 2px;
  width: 27px; height: 27px; background-color: #fff;
  border-radius: 50%; box-shadow: 0 3px 8px rgba(0,0,0,0.3);
  transition: transform 0.25s;
}
.switch.on { background-color: var(--green); }
.switch.on::after { transform: translateX(20px); }

/* Profile Card */
.profile-row {
  display: flex; align-items: center; padding: 12px 16px; gap: 14px;
}
.profile-avatar {
  width: 60px; height: 60px; border-radius: 50%;
  background: #636366; display: flex; align-items: center; justify-content: center;
  font-size: 24px; color: #fff; font-weight: 600; flex-shrink: 0;
  overflow: hidden;
}
.profile-avatar img { width: 100%; height: 100%; object-fit: cover; }
.profile-info { flex: 1; min-width: 0; }
.profile-name { font-size: 20px; font-weight: 600; }
.profile-sub { font-size: 13px; color: var(--text-muted); margin-top: 2px; }

/* Search Bar */
.search-container { padding: 0 16px 12px; }
.search-box {
  background: #1c1c1e; border-radius: 10px;
  display: flex; align-items: center; padding: 8px 12px; gap: 8px;
  color: var(--text-muted); font-size: 17px;
}
.search-box svg { width: 16px; height: 16px; fill: currentColor; }

/* Battery Specific Charts */
.battery-header-card {
  padding: 16px; display: flex; justify-content: space-between; align-items: center;
}
.battery-pct { font-size: 44px; font-weight: 700; }
.battery-sub { font-size: 13px; color: var(--text-muted); margin-top: 4px; }
.battery-info-btn { width: 20px; height: 20px; border-radius: 50%; border: 1px solid var(--text-muted); color: var(--text-muted); display: flex; align-items: center; justify-content: center; font-size: 11px; }

.chart-card { padding: 16px; }
.chart-title { font-size: 15px; font-weight: 600; margin-bottom: 12px; display: flex; justify-content: space-between; }
.chart-bars { display: flex; align-items: flex-end; justify-content: space-between; height: 110px; padding-top: 20px; border-bottom: 0.5px solid var(--separator); }
.chart-col { display: flex; flex-direction: column; align-items: center; gap: 6px; flex: 1; }
.chart-bar-wrap { width: 18px; height: 80px; background: #2c2c2e; border-radius: 4px; display: flex; align-items: flex-end; overflow: hidden; }
.chart-bar-fill { width: 100%; background: var(--blue); border-radius: 4px; }
.chart-bar-fill.green { background: var(--green); }
.chart-label { font-size: 11px; color: var(--text-muted); }

/* App Battery Usage List */
.app-usage-item {
  display: flex; align-items: center; justify-content: space-between; padding: 10px 16px;
}
.app-icon { width: 32px; height: 32px; border-radius: 7px; overflow: hidden; background: #3a3a3c; display: flex; align-items: center; justify-content: center; font-size: 18px; }
.app-details { flex: 1; margin-left: 12px; }
.app-name { font-size: 16px; font-weight: 400; }
.app-time { font-size: 12px; color: var(--text-muted); margin-top: 2px; }
.app-pct { font-size: 16px; font-weight: 500; color: var(--text-muted); }

/* Colors */
.bg-airplane { background-color: #ff9f0a; }
.bg-wifi { background-color: #0a84ff; }
.bg-bt { background-color: #0a84ff; }
.bg-cellular { background-color: #30d158; }
