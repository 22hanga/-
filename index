<script>
let navigationHistory = ['screen-home'];

function navTo(screenId) {
  const currentScreen = document.querySelector('.screen.active');
  const targetScreen = document.getElementById(screenId);
  
  if (targetScreen) {
    if (currentScreen) currentScreen.classList.remove('active');
    targetScreen.classList.add('active');
    navigationHistory.push(screenId);
    window.scrollTo(0, 0);
  }
}

function navBack(fallbackScreenId) {
  if (navigationHistory.length > 1) {
    const currentScreenId = navigationHistory.pop();
    const prevScreenId = navigationHistory[navigationHistory.length - 1];
    
    const currentScreen = document.getElementById(currentScreenId);
    const prevScreen = document.getElementById(prevScreenId);
    
    currentScreen.classList.add('back-anim');
    prevScreen.classList.add('active');
    
    setTimeout(() => {
      currentScreen.classList.remove('active', 'back-anim');
    }, 250);
  } else if (fallbackScreenId) {
    navTo(fallbackScreenId);
  }
}

function toggleSwitch(element, event) {
  event.stopPropagation();
  element.classList.toggle('on');
}

// iOS Safari 뷰포트 바운스 방지
document.body.addEventListener('touchmove', function(e) {
  if (document.querySelector('.screen.active').scrollHeight <= window.innerHeight) {
    e.preventDefault();
  }
}, { passive: false });
</script>
